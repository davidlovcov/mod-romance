#
# mod-true-companion configuration
# Copy to mod_true_companion.conf in your worldserver configs/modules directory.
# These are SERVER-WIDE administrator settings. Players change their own
# companion preferences in the TrueCompanion addon, within these limits.
#

[worldserver]

###################################################################################################
# MODULE
###################################################################################################

#    TrueCompanion.Enable
#        Description: Enable the True Companion module.
#        Default:     1
TrueCompanion.Enable = 1

#    TrueCompanion.Debug
#        Description: Extra log output (module logger) for gifts, protocol errors and requests.
#        Default:     0
TrueCompanion.Debug = 0

#    TrueCompanion.MaxActiveCompanionsPerPlayer
#        Description: AI (Ollama) companions a single player character may have active at once.
#                     Other Playerbots of the same player are never sent to Ollama.
#                     With several companions, the one you name answers; otherwise the one you talked to last.
#        Default:     3
TrueCompanion.MaxActiveCompanionsPerPlayer = 3

#    TrueCompanion.MaxAiCompanionsServer
#        Description: Server-wide limit of simultaneously active AI companions.
#        Default:     50
TrueCompanion.MaxAiCompanionsServer = 50

#    TrueCompanion.AllowLinkedAccounts
#        Description: Allow characters of accounts linked with ".playerbots account link" as companions.
#        Default:     1
TrueCompanion.AllowLinkedAccounts = 1

#    TrueCompanion.AllowInitialStageSelection / TrueCompanion.MaxInitialStage
#        Description: Let players pick the starting relationship (e.g. already a couple).
#                     Stages: 0 strangers, 1 acquaintances, 2 friends, 3 close friends,
#                     4 romantic interest, 5 dating/couple, 6 engaged, 7 married.
#        Default:     1 / 7
TrueCompanion.AllowInitialStageSelection = 1
TrueCompanion.MaxInitialStage = 7

###################################################################################################
# OLLAMA (local LLM)
###################################################################################################

#    TrueCompanion.Ollama.Enable
#        Description: Use Ollama for conversations. When 0 (or while Ollama is unreachable), there is no
#                     conversation, but everything else works: commands ("lead the way", "sell your junk"),
#                     lead mode, quests, the addon. She then says what she did in plain words.
#        Default:     1
TrueCompanion.Ollama.Enable = 1

#    TrueCompanion.Ollama.Url
#        Description: Ollama base URL (http only; localhost or a trusted LAN host).
#        Default:     "http://127.0.0.1:11434"
TrueCompanion.Ollama.Url = "http://127.0.0.1:11434"

#    TrueCompanion.Ollama.Model / TrueCompanion.Ollama.FallbackModel
#        Description: Default model and the model used if the default is not installed.
#        Default:     "qwen3.5:4b" / "qwen3:4b-instruct"
TrueCompanion.Ollama.Model = "qwen3.5:4b"
TrueCompanion.Ollama.FallbackModel = "qwen3:4b-instruct"

#    TrueCompanion.Ollama.AllowPlayerModelChoice / TrueCompanion.Ollama.AllowedModels
#        Description: Let players pick a model in the addon. AllowedModels is a comma separated
#                     allow-list ("" = any installed model).
#        Default:     1 / ""
TrueCompanion.Ollama.AllowPlayerModelChoice = 1
TrueCompanion.Ollama.AllowedModels = ""

#    TrueCompanion.Ollama.Temperature / MinTemperature / MaxTemperature
#        Description: Sampling temperature and the range players may choose from.
#        Default:     0.8 / 0.2 / 1.2
TrueCompanion.Ollama.Temperature = 0.8
TrueCompanion.Ollama.MinTemperature = 0.2
TrueCompanion.Ollama.MaxTemperature = 1.2

#    TrueCompanion.Ollama.ContextLength
#        Description: num_ctx sent to Ollama.
#        Default:     8192
TrueCompanion.Ollama.ContextLength = 8192

#    TrueCompanion.Ollama.MaxResponseTokens / TrueCompanion.Ollama.MaxReplyChars
#        Description: num_predict, and the hard cap on characters said in chat per reply.
#        Default:     300 / 450
TrueCompanion.Ollama.MaxResponseTokens = 300
TrueCompanion.Ollama.MaxReplyChars = 450

#    TrueCompanion.Ollama.Thinking
#        Description: Allow "thinking" for reasoning models. Off = faster, more responsive chat.
#        Default:     0
TrueCompanion.Ollama.Thinking = 0

#    TrueCompanion.Ollama.StructuredOutput
#        Description: Request JSON-schema constrained output (recommended). Falls back automatically.
#        Default:     1
TrueCompanion.Ollama.StructuredOutput = 1

#    TrueCompanion.Ollama.RequestTimeoutMs / ConnectTimeoutMs
#        Default:     45000 / 3000
TrueCompanion.Ollama.RequestTimeoutMs = 45000
TrueCompanion.Ollama.ConnectTimeoutMs = 3000

#    TrueCompanion.Ollama.MaxConcurrentRequests
#        Description: Worker threads talking to Ollama (bounded pool; never the world thread).
#        Default:     2
TrueCompanion.Ollama.MaxConcurrentRequests = 2

#    TrueCompanion.Ollama.MaxQueuedRequests / MaxPendingPerCompanion
#        Description: Global queue bound (backpressure) and per-companion in-flight limit.
#        Default:     16 / 2
TrueCompanion.Ollama.MaxQueuedRequests = 16
TrueCompanion.Ollama.MaxPendingPerCompanion = 2

#    TrueCompanion.Ollama.MinResponseCooldownMs
#        Description: Minimum time between two roleplay messages accepted for one companion
#                     (spam protection; Playerbots commands are not affected).
#        Default:     1500
TrueCompanion.Ollama.MinResponseCooldownMs = 1500

#    TrueCompanion.Ollama.HealthCheckIntervalSec
#        Default:     30
TrueCompanion.Ollama.HealthCheckIntervalSec = 30

#    TrueCompanion.Ollama.KeepAlive
#        Description: How long Ollama keeps the model loaded between requests.
#        Default:     "10m"
TrueCompanion.Ollama.KeepAlive = "10m"

###################################################################################################
# CONVERSATION
###################################################################################################

#    TrueCompanion.Chat.HistoryTurns / TrueCompanion.Chat.StoredTurns
#        Description: Recent turns sent to the model / turns kept in the database per companion.
#        Default:     12 / 80
TrueCompanion.Chat.HistoryTurns = 12
TrueCompanion.Chat.StoredTurns = 80

#    TrueCompanion.Chat.MaxPlayerMessageChars / MaxProfileFieldChars / MaxInstructionChars
#        Default:     500 / 600 / 1200
TrueCompanion.Chat.MaxPlayerMessageChars = 500
TrueCompanion.Chat.MaxProfileFieldChars = 600
TrueCompanion.Chat.MaxInstructionChars = 1200

#    TrueCompanion.Presets.MaxCustomPerAccount
#        Description: How many custom personality presets a player account can save
#                     ("Save as preset" in the addon). 0 disables custom presets.
#        Default:     20
TrueCompanion.Presets.MaxCustomPerAccount = 20

###################################################################################################
# COMPANION CONTROL
#
#    TrueCompanion.Control.Enable
#        Description: Natural-language commands in chat: give items/gold (trade), cast a spell,
#                     attack an enemy by name or type, sell junk, share quests, lead to a quest.
#                     Questions about the companion's bags, quests, spells, gold, XP and your target are
#                     answered from real game data.
#        Default:     1
TrueCompanion.Control.Enable = 1

#    TrueCompanion.Control.GiveMinStage
#        Description: Relationship stage needed before the companion hands over items or gold.
#                     0 strangers, 1 acquaintances, 2 friends, 3 close friends, 4 romantic interest,
#                     5 dating, 6 engaged, 7 married.
#        Default:     2
TrueCompanion.Control.GiveMinStage = 2

#    TrueCompanion.Control.MaxGoldPerRequest
#        Description: Most gold the companion gives for one request. 0 = no limit.
#        Default:     50
TrueCompanion.Control.MaxGoldPerRequest = 50

#    TrueCompanion.Control.AutoSellJunk / AutoSellFreeSlots
#        Description: Sell gray items automatically when the companion stands at a vendor with this many
#                     free bag slots or fewer.
#        Default:     1 / 2
TrueCompanion.Control.AutoSellJunk = 1
TrueCompanion.Control.AutoSellFreeSlots = 2

#    TrueCompanion.Control.LeadMode
#        Description: "lead the way" makes the companion walk to one of their quests (you follow). They wait when
#                     you fall behind, fight the quest creatures when they arrive and follow you again
#                     when the objectives are done or when you say "I'll lead".
#        Default:     1
TrueCompanion.Control.LeadMode = 1

#    TrueCompanion.Control.CommandRange
#        Description: Yards to search for an enemy named in a command ("attack the wolf").
#        Default:     50
TrueCompanion.Control.CommandRange = 50

#    TrueCompanion.Control.InteractRange
#        Description: Merchants and quest givers this close (yards) count as "here": "sell your junk",
#                     "accept the quest" and "turn in your quests" work without targeting them.
#        Default:     30
TrueCompanion.Control.InteractRange = 30

#    TrueCompanion.Control.QuestSync
#        Description: Companions near you take a quest when you take it and turn it in when you do
#                     (if they can: level, class, earlier quests).
#        Default:     1
TrueCompanion.Control.QuestSync = 1

#    TrueCompanion.Party.UnaddressedReplies
#        Description: Party lines without a name, when only bots share your group:
#                     all  - every companion may answer
#                     last - only the companion you talked to last
#                     Lines with names ("Jina, Tristi, ...") or "everyone/all of you/guys" always reach
#                     exactly those companions.
#        Default:     all
TrueCompanion.Party.UnaddressedReplies = all

###################################################################################################
# ESTRANGEMENT
#
#    TrueCompanion.Estrangement.Enable
#        Description: A companion who is insulted and mistreated again and again leaves you: they
#                     say goodbye, leaves the group and logs out. The relationship drops to
#                     Acquaintances (Strangers if it happens again).
#        Default:     1
TrueCompanion.Estrangement.Enable = 1

#    TrueCompanion.Estrangement.Resentment
#        Description: Resentment (0-100) at which the companion leaves. Insults add about 14, rudeness 6,
#                     broken promises 10; resentment fades by about 4 points per day.
#        Default:     100
TrueCompanion.Estrangement.Resentment = 100

#    TrueCompanion.Estrangement.CooldownHours
#        Description: Hours the companion refuses to be called after leaving. Doubles the second time,
#                     4x from the third time on.
#        Default:     72
TrueCompanion.Estrangement.CooldownHours = 72

#    TrueCompanion.Estrangement.ReconcilePerDay
#        Description: After the cooldown the companion comes back cold. Apologies and kindness add
#                     reconciliation points (100 needed) - at most this many per day, so winning
#                     them back takes several days. Any new insult makes them leave again.
#        Default:     25
TrueCompanion.Estrangement.ReconcilePerDay = 25

#    TrueCompanion.Chat.PartyOnly
#        Description: Companions always answer in party chat instead of whispers.
#        Default:     0
TrueCompanion.Chat.PartyOnly = 0

#    TrueCompanion.Chat.Language
#        Description: auto (match the player per message, EN/DE), en, de
#        Default:     "auto"
TrueCompanion.Chat.Language = "auto"

#    TrueCompanion.Chat.NaturalLanguageCommands
#        Description: "Elara, follow me." -> Playerbots "follow" (strict allow-list:
#                     follow, stay, attack, flee). Players can still disable it per companion.
#        Default:     1
TrueCompanion.Chat.NaturalLanguageCommands = 1

#    TrueCompanion.Chat.GameplayContext
#        Description: Include observed game state (zone, health, fights...) in prompts.
#        Default:     1
TrueCompanion.Chat.GameplayContext = 1

#    TrueCompanion.Chat.QuietInInstances
#        Description: Suppress proactive chatter inside dungeons/raids (combat is always quiet).
#        Default:     0
TrueCompanion.Chat.QuietInInstances = 0

###################################################################################################
# PROACTIVE CONVERSATION
###################################################################################################

#    TrueCompanion.Proactive.Enable
#        Default:     1
TrueCompanion.Proactive.Enable = 1

#    TrueCompanion.Proactive.MinIntervalSec / MaxIntervalSec
#        Description: Spacing of spontaneous lines (scaled by player frequency and personality initiative,
#                     doubled after each unanswered line; stops after two unanswered lines).
#        Default:     240 / 900
TrueCompanion.Proactive.MinIntervalSec = 240
TrueCompanion.Proactive.MaxIntervalSec = 900

#    TrueCompanion.Proactive.Chance / TrueCompanion.Proactive.MaxPerHour
#        Default:     0.6 / 6
TrueCompanion.Proactive.Chance = 0.6
TrueCompanion.Proactive.MaxPerHour = 6

#    TrueCompanion.Proactive.IdleCheckInSec
#        Description: Silence after which a gentle "are you still there?" may happen (once).
#        Default:     600
TrueCompanion.Proactive.IdleCheckInSec = 600

#    TrueCompanion.Proactive.EventReactionCooldownSec / EventReactionChance
#        Description: Reactions to ordinary events (won fights, quests, new zones). Important events
#                     (near death, level up, summon, gifts) always get a reaction.
#        Default:     90 / 0.5
TrueCompanion.Proactive.EventReactionCooldownSec = 90
TrueCompanion.Proactive.EventReactionChance = 0.5

###################################################################################################
# MEMORY
###################################################################################################

#    TrueCompanion.Memory.Enable
#        Default:     1
TrueCompanion.Memory.Enable = 1

#    TrueCompanion.Memory.MaxPerCompanion
#        Description: Upper bound; least important, old, unpinned entries are pruned first.
#                     Milestones, pinned and player-edited memories are never pruned; when
#                     only those are left, new player-written memories are refused.
#        Default:     400
TrueCompanion.Memory.MaxPerCompanion = 400

#    TrueCompanion.Memory.RetrievalCount / RetrievalChars
#        Description: Memories selected per prompt (relevance + importance + recency).
#        Default:     10 / 1400
TrueCompanion.Memory.RetrievalCount = 10
TrueCompanion.Memory.RetrievalChars = 1400

#    TrueCompanion.Memory.SummarizeEveryTurns
#        Description: Summarize conversation into episodic memory every N turns (0 = off).
#        Default:     24
TrueCompanion.Memory.SummarizeEveryTurns = 24

#    TrueCompanion.Memory.RetentionDays
#        Description: Forget low-importance memories older than this (0 = keep).
#        Default:     0
TrueCompanion.Memory.RetentionDays = 0

#    TrueCompanion.Memory.DedupeThreshold
#        Description: Similarity (0..1) above which a new memory is merged into an existing one.
#        Default:     0.72
TrueCompanion.Memory.DedupeThreshold = 0.72

###################################################################################################
# RELATIONSHIP
###################################################################################################

#    TrueCompanion.Relationship.ProgressionSpeed / GainMultiplier / LossMultiplier
#        Default:     1.0 / 1.0 / 1.0
TrueCompanion.Relationship.ProgressionSpeed = 1.0
TrueCompanion.Relationship.GainMultiplier = 1.0
TrueCompanion.Relationship.LossMultiplier = 1.0

#    TrueCompanion.Relationship.MoodSensitivity / RomanticInitiative
#        Default:     1.0 / 1.0
TrueCompanion.Relationship.MoodSensitivity = 1.0
TrueCompanion.Relationship.RomanticInitiative = 1.0

#    TrueCompanion.Relationship.DailyGainCap
#        Description: Maximum positive points per day from conversation (keeps it gradual).
#        Default:     12
TrueCompanion.Relationship.DailyGainCap = 12

#    TrueCompanion.Relationship.MinDaysDatingBeforeEngagement / MinDaysEngagedBeforeMarriage
#        Default:     2 / 1
TrueCompanion.Relationship.MinDaysDatingBeforeEngagement = 2
TrueCompanion.Relationship.MinDaysEngagedBeforeMarriage = 1

#    TrueCompanion.Relationship.RequireRingForEngagement
#        Description: A ring must have been traded within the last hour for an engagement "yes".
#        Default:     0
TrueCompanion.Relationship.RequireRingForEngagement = 0

#    TrueCompanion.Relationship.NeglectDaysBeforeDecay
#        Default:     7
TrueCompanion.Relationship.NeglectDaysBeforeDecay = 7

###################################################################################################
# GIFTS
###################################################################################################

#    TrueCompanion.Gift.Multiplier / JewelryMultiplier / DailyCap
#        Default:     1.0 / 1.6 / 30
TrueCompanion.Gift.Multiplier = 1.0
TrueCompanion.Gift.JewelryMultiplier = 1.6
TrueCompanion.Gift.DailyCap = 30

#    TrueCompanion.Gift.RomanticItemEntries
#        Description: Comma separated item entries treated as romantic gifts (in addition to keywords).
#        Default:     ""
TrueCompanion.Gift.RomanticItemEntries = ""

#    TrueCompanion.Gift.RomanticKeywords
#        Description: Comma separated name keywords for romantic items ("" = built-in EN/DE list).
#        Default:     ""
TrueCompanion.Gift.RomanticKeywords = ""

###################################################################################################
# PRIVACY
###################################################################################################

#    TrueCompanion.Privacy.AllowExport / AllowFullReset / DebugTabForPlayers
#        Default:     1 / 1 / 1
TrueCompanion.Privacy.AllowExport = 1
TrueCompanion.Privacy.AllowFullReset = 1
TrueCompanion.Privacy.DebugTabForPlayers = 1
